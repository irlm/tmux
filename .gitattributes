# Scripts and data the Bash side reads must stay LF even on a Windows checkout
# with core.autocrlf=true; PowerShell files take the platform's endings.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.tsv text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.conf text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.ps1 text
